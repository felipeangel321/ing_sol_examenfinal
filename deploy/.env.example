# deploy/.env.example — variables del servidor (NO poner secretos reales aquí).
# En la EC2:  cd ~/app/deploy && cp .env.example .env && nano .env
# deploy/.env queda fuera de git (.gitignore) y fuera de la imagen (.dockerignore).

# --- Groq ---
# La clave va SOLO en el .env de la EC2. Si se filtra: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_REASONING="medium"

# --- Búsqueda en las pólizas ---
# true = palabras + semántica (el modelo ya viene dentro de la imagen).
BUSQUEDA_SEMANTICA="true"

# --- Protección de la cuota de Groq (~25 preguntas al día en el plan gratuito) ---
# Máximo de preguntas que llegan al modelo en 24 h (todos los usuarios juntos).
TOPE_DIARIO_PREGUNTAS="25"

# Link secreto del dueño:  https://<IP>/entrar?clave=<CLAVE_ACCESO>
# Con él tu navegador usa un cupo reservado y ve el panel. bootstrap-ec2.sh la genera
# sola (openssl rand -hex 16) y iniciar.sh imprime el link. No la compartas.
CLAVE_ACCESO=""

# Cupos diarios (solo funcionan si hay CLAVE_ACCESO). Público + dueño = el tope de arriba.
CUPO_PUBLICO_DIA="15"     # preguntas del público al día, sumando a todos
CUPO_IP_DIA="5"           # de esas, por IP (en el WiFi del Duoc todo el curso es UNA IP)
CUPO_PUBLICO_CADA_S="120" # el público hace como mucho 1 pregunta cada 2 minutos
CUPO_DUENO_DIA="10"       # tu cupo reservado: el público no lo puede gastar

# Freno de inundación: peticiones de cualquier tipo por IP y por minuto.
LIMITE_PETICIONES_MIN="120"

# --- Docs interactivas de FastAPI (/docs) ---
# Apagadas en el servidor público. "true" solo para probar.
ENABLE_DOCS="false"

# --- Dirección que sirve Caddy por HTTPS ---
# deploy/iniciar.sh la completa sola con la IP pública de la EC2 (cambia en cada
# sesión del Learner Lab). Solo edítala a mano si usas un dominio propio.
SITE_ADDRESS="localhost"
