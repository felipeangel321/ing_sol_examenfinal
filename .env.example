# Copia este archivo como .env y completa los valores. Nunca subas .env al repo.

# Groq: https://console.groq.com/ > API Keys (empieza con "gsk_")
GROQ_API_KEY=""
# Modelo de los agentes (gpt-oss-20b es estable con herramientas)
GROQ_MODEL="openai/gpt-oss-20b"
# Cuánto "piensa" el modelo antes de responder: low, medium o high
GROQ_REASONING="medium"

# Búsqueda en documentos: true = palabras + semántica (embeddings locales,
# la primera vez descarga ~470 MB); false = solo por palabras
BUSQUEDA_SEMANTICA="true"
